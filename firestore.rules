rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 2 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'supervisor1.atcvento@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Entity Validation Blueprints ---
    function isValidMotorcycle(data) {
      return data.keys().hasAll([
        'id', 'brand', 'family', 'model', 'displacementCc', 'engineType',
        'powerHp', 'transmission', 'cooling', 'brakes', 'tankLiters',
        'topSpeedKmh', 'breakInNotes', 'imageUrl', 'isActive', 'highlights',
        'createdAt', 'updatedAt'
      ]) && data.keys().hasOnly([
        'id', 'brand', 'family', 'model', 'displacementCc', 'engineType',
        'powerHp', 'transmission', 'cooling', 'brakes', 'tankLiters',
        'topSpeedKmh', 'breakInNotes', 'imageUrl', 'isActive', 'highlights',
        'customSpecs', 'hiddenFields', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.brand in ['VENTO', 'AMERICAN PISTON']
      && data.family is string && data.family.size() >= 2 && data.family.size() <= 48
      && data.model is string && data.model.size() >= 2 && data.model.size() <= 80
      && data.displacementCc is number && data.displacementCc >= 49 && data.displacementCc <= 2500
      && data.engineType is string && data.engineType.size() >= 2 && data.engineType.size() <= 120
      && data.powerHp is string && data.powerHp.size() >= 1 && data.powerHp.size() <= 40
      && data.transmission is string && data.transmission.size() >= 2 && data.transmission.size() <= 80
      && data.cooling is string && data.cooling.size() >= 2 && data.cooling.size() <= 60
      && data.brakes is string && data.brakes.size() >= 2 && data.brakes.size() <= 80
      && data.tankLiters is string && data.tankLiters.size() >= 1 && data.tankLiters.size() <= 30
      && data.topSpeedKmh is number && data.topSpeedKmh >= 10 && data.topSpeedKmh <= 350
      && data.breakInNotes is string && data.breakInNotes.size() >= 2 && data.breakInNotes.size() <= 300
      && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 600000
      && data.isActive is bool
      && data.highlights is list && data.highlights.size() <= 8
      && (data.highlights.size() == 0 || (data.highlights[0] is string && data.highlights[0].size() <= 120))
      && (!('customSpecs' in data) || (data.customSpecs is map && data.customSpecs.size() <= 40))
      && (!('hiddenFields' in data) || (
        data.hiddenFields is list && data.hiddenFields.size() <= 40
        && (data.hiddenFields.size() == 0 || (data.hiddenFields[0] is string && data.hiddenFields[0].size() <= 80))
      ))
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidSpecField(data) {
      return data.keys().hasAll([
        'id', 'key', 'label', 'section', 'isCore', 'isVisible',
        'order', 'placeholder', 'createdAt', 'updatedAt'
      ]) && data.keys().hasOnly([
        'id', 'key', 'label', 'section', 'isCore', 'isVisible',
        'order', 'placeholder', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.key is string && data.key.size() >= 1 && data.key.size() <= 64 && data.key.matches('^[a-zA-Z0-9_\\-]+$')
      && data.label is string && data.label.size() >= 1 && data.label.size() <= 80
      && data.section in ['Motor', 'Transmisión', 'Frenos y Suspensión', 'Dimensiones y Capacidades', 'Equipamiento y Tecnología', 'Asentamiento y Garantía']
      && data.isCore is bool
      && data.isVisible is bool
      && data.order is number && data.order >= 0 && data.order <= 500
      && data.placeholder is string && data.placeholder.size() <= 120
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidQuizQuestion(data) {
      return data.keys().hasAll([
        'id', 'kind', 'topic', 'brand', 'sourceSection', 'sourceField',
        'question', 'options', 'correctIndex', 'explanation',
        'targetScope', 'targetFamily', 'targetModelIds', 'isActive',
        'createdAt', 'updatedAt'
      ]) && data.keys().hasOnly([
        'id', 'kind', 'topic', 'brand', 'sourceSection', 'sourceField',
        'question', 'options', 'correctIndex', 'explanation',
        'targetScope', 'targetFamily', 'targetModelIds', 'isActive',
        'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.kind in ['fixed', 'template']
      && data.topic in ['Especificaciones', 'Familias', 'Garantías', 'Guía de Tiempos']
      && data.brand in ['VENTO', 'AMERICAN PISTON', 'AMBAS']
      && data.sourceSection is string && data.sourceSection.size() >= 1 && data.sourceSection.size() <= 100
      && data.sourceField is string && data.sourceField.size() >= 1 && data.sourceField.size() <= 64
      && data.question is string && data.question.size() >= 5 && data.question.size() <= 320
      && data.options is list && data.options.size() <= 4
      && (data.options.size() == 0 || (data.options[0] is string && data.options[0].size() <= 200))
      && data.correctIndex is number && data.correctIndex >= 0 && data.correctIndex <= 3
      && data.explanation is string && data.explanation.size() <= 500
      && data.targetScope in ['ALL', 'FAMILY', 'MODELS']
      && data.targetFamily is string && data.targetFamily.size() <= 48
      && data.targetModelIds is list && data.targetModelIds.size() <= 80
      && (data.targetModelIds.size() == 0 || (data.targetModelIds[0] is string && data.targetModelIds[0].size() <= 64))
      && data.isActive is bool
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidWarrantyPolicy(data) {
      return data.keys().hasAll([
        'id', 'brand', 'category', 'title', 'summary', 'keyRule',
        'details', 'order', 'isActive', 'createdAt', 'updatedAt'
      ]) && data.keys().hasOnly([
        'id', 'brand', 'category', 'title', 'summary', 'keyRule',
        'details', 'order', 'isActive', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.brand in ['VENTO', 'AMERICAN PISTON']
      && data.category in ['Condiciones', 'Asentamiento', 'Exclusiones', 'Servicios', 'Canales', 'Seguridad']
      && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
      && data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 400
      && data.keyRule is string && data.keyRule.size() >= 1 && data.keyRule.size() <= 160
      && data.details is list && data.details.size() <= 15
      && (data.details.size() == 0 || (data.details[0] is string && data.details[0].size() <= 400))
      && data.order is number && data.order >= 0 && data.order <= 500
      && data.isActive is bool
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidTimeGuide(data) {
      return data.keys().hasAll([
        'id', 'code', 'section', 'component', 'cuatrimotosTime',
        'motonetasTime', 'motocicletasTime', 'notes', 'accessories',
        'isActive', 'createdAt', 'updatedAt'
      ]) && data.keys().hasOnly([
        'id', 'code', 'section', 'component', 'cuatrimotosTime',
        'motonetasTime', 'motocicletasTime', 'notes', 'accessories',
        'isActive', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.code is string && data.code.size() >= 2 && data.code.size() <= 16
      && data.section in ['VC', 'VM']
      && data.component is string && data.component.size() >= 2 && data.component.size() <= 100
      && data.cuatrimotosTime is string && data.cuatrimotosTime.size() >= 1 && data.cuatrimotosTime.size() <= 160
      && data.motonetasTime is string && data.motonetasTime.size() >= 1 && data.motonetasTime.size() <= 160
      && data.motocicletasTime is string && data.motocicletasTime.size() >= 1 && data.motocicletasTime.size() <= 160
      && data.notes is string && data.notes.size() <= 500
      && data.accessories is list && data.accessories.size() <= 15
      && (data.accessories.size() == 0 || (data.accessories[0] is string && data.accessories[0].size() <= 120))
      && data.isActive is bool
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidAdvisor(data) {
      return data.keys().hasAll([
        'uid', 'displayName', 'branch', 'quizPoints', 'gameHighScore',
        'totalPoints', 'quizzesCompleted', 'correctAnswers', 'streakBest',
        'createdAt', 'updatedAt'
      ]) && data.keys().hasOnly([
        'uid', 'displayName', 'branch', 'quizPoints', 'gameHighScore',
        'totalPoints', 'quizzesCompleted', 'correctAnswers', 'streakBest',
        'createdAt', 'updatedAt'
      ])
      && isValidId(data.uid)
      && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 60
      && data.branch is string && data.branch.size() <= 60
      && data.quizPoints is number && data.quizPoints >= 0 && data.quizPoints <= 1000000
      && data.gameHighScore is number && data.gameHighScore >= 0 && data.gameHighScore <= 1000000
      && data.totalPoints is number && data.totalPoints >= 0 && data.totalPoints <= 2000000
      && data.totalPoints == data.quizPoints + data.gameHighScore
      && data.quizzesCompleted is number && data.quizzesCompleted >= 0 && data.quizzesCompleted <= 100000
      && data.correctAnswers is number && data.correctAnswers >= 0 && data.correctAnswers <= 100000
      && data.streakBest is number && data.streakBest >= 0 && data.streakBest <= 1000
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidQuizSession(data) {
      return data.keys().hasAll([
        'id', 'advisorUid', 'advisorName', 'topic', 'score',
        'correctCount', 'totalQuestions', 'createdAt'
      ]) && data.keys().hasOnly([
        'id', 'advisorUid', 'advisorName', 'topic', 'score',
        'correctCount', 'totalQuestions', 'createdAt'
      ])
      && isValidId(data.id)
      && isValidId(data.advisorUid)
      && data.advisorName is string && data.advisorName.size() >= 2 && data.advisorName.size() <= 60
      && data.topic in ['Especificaciones', 'Familias', 'Garantías', 'Guía de Tiempos', 'Mixto']
      && data.score is number && data.score >= 0 && data.score <= 50000
      && data.correctCount is number && data.correctCount >= 0 && data.correctCount <= 100
      && data.totalQuestions is number && data.totalQuestions >= 1 && data.totalQuestions <= 100
      && data.createdAt is timestamp;
    }

    // --- Collection Rules ---
    match /motorcycles/{motoId} {
      allow get: if isValidId(motoId) && (existing().isActive == true || isAdmin());
      allow list: if existing().isActive == true || isBootstrappedAdmin();
      allow create: if isValidId(motoId) && isValidMotorcycle(incoming()) && isAdmin()
        && incoming().id == motoId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(motoId) && isValidMotorcycle(incoming()) && isAdmin()
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'brand', 'family', 'model', 'displacementCc', 'engineType',
          'powerHp', 'transmission', 'cooling', 'brakes', 'tankLiters',
          'topSpeedKmh', 'breakInNotes', 'imageUrl', 'isActive', 'highlights',
          'customSpecs', 'hiddenFields', 'updatedAt'
        ]);
      allow delete: if isValidId(motoId) && isAdmin();
    }

    match /specFields/{fieldId} {
      allow get: if isValidId(fieldId) && (existing().isVisible == true || isAdmin());
      allow list: if existing().isVisible == true || isBootstrappedAdmin();
      allow create: if isValidId(fieldId) && isValidSpecField(incoming()) && isAdmin()
        && incoming().id == fieldId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(fieldId) && isValidSpecField(incoming()) && isAdmin()
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'key', 'label', 'section', 'isCore', 'isVisible', 'order', 'placeholder', 'updatedAt'
        ]);
      allow delete: if isValidId(fieldId) && isAdmin();
    }

    match /quizQuestions/{questionId} {
      allow get: if isValidId(questionId) && (existing().isActive == true || isAdmin());
      allow list: if existing().isActive == true || isBootstrappedAdmin();
      allow create: if isValidId(questionId) && isValidQuizQuestion(incoming()) && isAdmin()
        && incoming().id == questionId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(questionId) && isValidQuizQuestion(incoming()) && isAdmin()
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'kind', 'topic', 'brand', 'sourceSection', 'sourceField',
          'question', 'options', 'correctIndex', 'explanation',
          'targetScope', 'targetFamily', 'targetModelIds', 'isActive', 'updatedAt'
        ]);
      allow delete: if isValidId(questionId) && isAdmin();
    }

    match /warrantyPolicies/{policyId} {
      allow get: if isValidId(policyId) && (existing().isActive == true || isAdmin());
      allow list: if existing().isActive == true || isBootstrappedAdmin();
      allow create: if isValidId(policyId) && isValidWarrantyPolicy(incoming()) && isAdmin()
        && incoming().id == policyId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(policyId) && isValidWarrantyPolicy(incoming()) && isAdmin()
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'brand', 'category', 'title', 'summary', 'keyRule',
          'details', 'order', 'isActive', 'updatedAt'
        ]);
      allow delete: if isValidId(policyId) && isAdmin();
    }

    match /timeGuides/{guideId} {
      allow get: if isValidId(guideId) && (existing().isActive == true || isAdmin());
      allow list: if existing().isActive == true || isBootstrappedAdmin();
      allow create: if isValidId(guideId) && isValidTimeGuide(incoming()) && isAdmin()
        && incoming().id == guideId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(guideId) && isValidTimeGuide(incoming()) && isAdmin()
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'code', 'section', 'component', 'cuatrimotosTime',
          'motonetasTime', 'motocicletasTime', 'notes', 'accessories',
          'isActive', 'updatedAt'
        ]);
      allow delete: if isValidId(guideId) && isAdmin();
    }

    match /advisors/{advisorId} {
      allow get: if isValidId(advisorId);
      allow list: if existing().totalPoints >= 0;
      allow create: if isVerifiedUser()
        && isValidId(advisorId)
        && advisorId == request.auth.uid
        && isValidAdvisor(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(advisorId)
        && isValidAdvisor(incoming())
        && (
          isAdmin() || (
            advisorId == request.auth.uid
            && incoming().uid == existing().uid
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'branch', 'quizPoints', 'gameHighScore',
              'totalPoints', 'quizzesCompleted', 'correctAnswers', 'streakBest', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(advisorId) && isAdmin();
    }

    match /quizSessions/{sessionId} {
      allow get: if isSignedIn() && isValidId(sessionId) && (existing().advisorUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().advisorUid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerifiedUser()
        && isValidId(sessionId)
        && isValidQuizSession(incoming())
        && incoming().advisorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (adminUid == request.auth.uid || isAdmin());
      allow list: if false;
      allow create, update, delete: if isValidId(adminUid) && isAdmin()
        && incoming().keys().hasAll(['uid', 'addedAt'])
        && incoming().keys().hasOnly(['uid', 'addedAt'])
        && incoming().uid == adminUid
        && incoming().addedAt == request.time;
    }
  }
}
